schLibName = "SAR9B"
    techLib = "tech"
    inputPinMaster=dbOpenCellView("basic" "ipin" "symbol" nil "r")
    outputPinMaster=dbOpenCellView("basic" "opin" "symbol" nil "r")
    inputOutputPinMaster=dbOpenCellView("basic" "iopin" "symbol" nil "r")

;Create cell
sch = dbOpenCellViewByType(schLibName "CDAC9_CV" "schematic" "schematic" "w")
schName = "CDAC9_CV"
xcoord = 1
ycoord = 0
        
myCP_13_ = schCreatePin( sch inputOutputPinMaster "CP<13>" "inputOutput" nil 0:0 "R0" )
myTermCP_13_ = (setof pin sch->terminals (pcreMatchp "CP<13>" pin->name))
myprebBoxCP_13_ = car(car(myCP_13_~>master~>terminals~>pins)~>fig~>bBox)
mybBoxCP_13_ = dbTransformBBox(myprebBoxCP_13_ myCP_13_~>transform)
            
myCP_12_ = schCreatePin( sch inputOutputPinMaster "CP<12>" "inputOutput" nil 0:0.2 "R0" )
