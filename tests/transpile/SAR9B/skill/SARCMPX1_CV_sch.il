schLibName = "SAR9B"
    techLib = "tech"
    inputPinMaster=dbOpenCellView("basic" "ipin" "symbol" nil "r")
    outputPinMaster=dbOpenCellView("basic" "opin" "symbol" nil "r")
    inputOutputPinMaster=dbOpenCellView("basic" "iopin" "symbol" nil "r")

;Create cell
sch = dbOpenCellViewByType(schLibName "SARCMPX1_CV" "schematic" "schematic" "w")
schName = "SARCMPX1_CV"
xcoord = 1
ycoord = 0
        
myCPI = schCreatePin( sch inputOutputPinMaster "CPI" "inputOutput" nil 0:0 "R0" )
myTermCPI = (setof pin sch->terminals (pcreMatchp "CPI" pin->name))
myprebBoxCPI = car(car(myCPI~>master~>terminals~>pins)~>fig~>bBox)
mybBoxCPI = dbTransformBBox(myprebBoxCPI myCPI~>transform)
            
myCNI = schCreatePin( sch inputOutputPinMaster "CNI" "inputOutput" nil 0:0.2 "R0" )
myTermCNI = (setof pin sch->terminals (pcreMatchp "CNI" pin->name))
myprebBoxCNI = car(car(myCNI~>master~>terminals~>pins)~>fig~>bBox)
mybBoxCNI = dbTransformBBox(myprebBoxCNI myCNI~>transform)
            
myCPO = schCreatePin( sch inputOutputPinMaster "CPO" "inputOutput" nil 0:0.4 "R0" )
myTermCPO = (setof pin sch->terminals (pcreMatchp "CPO" pin->name))
myprebBoxCPO = car(car(myCPO~>master~>terminals~>pins)~>fig~>bBox)
mybBoxCPO = dbTransformBBox(myprebBoxCPO myCPO~>transform)
            
myCNO = schCreatePin( sch inputOutputPinMaster "CNO" "inputOutput" nil 0:0.6000000000000001 "R0" )
myTermCNO = (setof pin sch->terminals (pcreMatchp "CNO" pin->name))
myprebBoxCNO = car(car(myCNO~>master~>terminals~>pins)~>fig~>bBox)
mybBoxCNO = dbTransformBBox(myprebBoxCNO myCNO~>transform)
            
myCK_CMP = schCreatePin( sch inputOutputPinMaster "CK_CMP" "inputOutput" nil 0:0.8 "R0" )
myTermCK_CMP = (setof pin sch->terminals (pcreMatchp "CK_CMP" pin->name))
myprebBoxCK_CMP = car(car(myCK_CMP~>master~>terminals~>pins)~>fig~>bBox)
mybBoxCK_CMP = dbTransformBBox(myprebBoxCK_CMP myCK_CMP~>transform)
            
myCK_SAMPLE = schCreatePin( sch inputOutputPinMaster "CK_SAMPLE" "inputOutput" nil 0:1.0 "R0" )
myTermCK_SAMPLE = (setof pin sch->terminals (pcreMatchp "CK_SAMPLE" pin->name))
myprebBoxCK_SAMPLE = car(car(myCK_SAMPLE~>master~>terminals~>pins)~>fig~>bBox)
mybBoxCK_SAMPLE = dbTransformBBox(myprebBoxCK_SAMPLE myCK_SAMPLE~>transform)
            
myDONE = schCreatePin( sch inputOutputPinMaster "DONE" "inputOutput" nil 0:1.2 "R0" )
myTermDONE = (setof pin sch->terminals (pcreMatchp "DONE" pin->name))
myprebBoxDONE = car(car(myDONE~>master~>terminals~>pins)~>fig~>bBox)
mybBoxDONE = dbTransformBBox(myprebBoxDONE myDONE~>transform)
            
myAVDD = schCreatePin( sch inputOutputPinMaster "AVDD" "inputOutput" nil 0:1.4 "R0" )
myTermAVDD = (setof pin sch->terminals (pcreMatchp "AVDD" pin->name))
myprebBoxAVDD = car(car(myAVDD~>master~>terminals~>pins)~>fig~>bBox)
mybBoxAVDD = dbTransformBBox(myprebBoxAVDD myAVDD~>transform)
            
myAVSS = schCreatePin( sch inputOutputPinMaster "AVSS" "inputOutput" nil 0:1.5999999999999999 "R0" )
myTermAVSS = (setof pin sch->terminals (pcreMatchp "AVSS" pin->name))
myprebBoxAVSS = car(car(myAVSS~>master~>terminals~>pins)~>fig~>bBox)
mybBoxAVSS = dbTransformBBox(myprebBoxAVSS myAVSS~>transform)
            
        syb =  ddGetObj("cpdk" "SARCMP" "symbol")
        if( syb then
          syb_dd = dbOpenCellViewByType("cpdk" "SARCMP" "symbol")
          dbCopyCellView(syb_dd schLibName schName "symbol" ?g_overwrite t)
        )


unless( ddGetObj(schLibName schName "symbol")
        schViewToView( schLibName schName schLibName schName "schematic" "symbol" "schSchemToPinList" "schPinListToSymbol" )
)
        
    ;;-------------------------------------------------------------------
    ;; Create instance XA0
    ;;-------------------------------------------------------------------
        schLib = dbOpenCellViewByType("SAR9B" "TAPCELL_CV" "symbol")
        schInst=dbCreateInst(sch schLib "XA0" xcoord:ycoord "R180")
        xcoord = xcoord  + rightEdge(schLib->bBox) - leftEdge(schLib->bBox) + 1
        if(xcoord > 15 then
                    xcoord = 2
                    ycoord = ycoord +  topEdge(schLib->bBox) - bottomEdge(schLib->bBox) + 1
        )

        
            signal = (setof sig schLib~>signals (member "TAP" sig~>sigNames))
            bBox = car(car(signal~>pins)~>fig)~>bBox
            pin =dbTransformBBox(bBox schInst~>transform)

            wireId = schCreateWire( sch "draw" "full" list(centerBox(pin) rodAddToX(centerBox(pin) 0.05) )  0.0625 0.0625 0.0 )
            schCreateWireLabel( sch car(wireId) rodAddToX(centerBox(pin) 0.125)  "AVSS" "lowerLeft" "R0" "stick" 0.0625 nil )
            
